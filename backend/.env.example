# CORS
ORIGINS=["*"]

# Database
DATABASE_URL=sqlite:///./classroom.db
# DATABASE_URL=postgresql://user:password@localhost:5432/classroom

# JWT
SECRET_KEY=change-this-to-a-long-random-string-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Recognition
RECOGNITION_MODEL=insightface
RECOGNITION_THRESHOLD=0.40  # Will be evidence-selected in Milestone 3
MIN_FACE_SIZE=80
BLUR_THRESHOLD=80.0
FACE_CONFIRMATION_FRAMES=5

# Session timing defaults
SESSION_START_OFFSET_MINUTES=0
SESSION_LATE_START_MINUTES=5
SESSION_LATE_END_MINUTES=15
SESSION_DURATION_MINUTES=60

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/classroom.log

# LED / IoT
LED_ENABLED=false
LED_MODE=mqtt  # or http
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=classroom/led