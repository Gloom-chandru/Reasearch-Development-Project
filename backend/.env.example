# ═══════════════════════════════════════════════════════════════════
#  Smart Classroom Backend — Environment Configuration Template
#  Copy this file to .env and fill in real values before running.
#  NEVER commit the real .env file — it contains secrets.
# ═══════════════════════════════════════════════════════════════════

# ── CORS ────────────────────────────────────────────────────────────
# For development, allow all origins. In production, list exact URLs:
# ORIGINS=["https://yourclassroom.example.com"]
ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default, zero config, fine for development and small deployments):
DATABASE_URL=sqlite:///./classroom.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://classroom_user:strongpassword@localhost:5432/classroom_db
# To create the PostgreSQL database:
#   createdb classroom_db
#   psql -c "CREATE USER classroom_user WITH PASSWORD 'strongpassword';"
#   psql -c "GRANT ALL PRIVILEGES ON DATABASE classroom_db TO classroom_user;"

# ── JWT Auth ─────────────────────────────────────────────────────────
# CRITICAL: Change SECRET_KEY before any deployment.
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 hours

# ── Face Recognition ─────────────────────────────────────────────────
# Primary backend: insightface (uses InsightFace buffalo_l, 512-d embeddings)
RECOGNITION_MODEL=insightface

# Recognition threshold (cosine similarity).
# DEFAULT = 0.40 — this is a PLACEHOLDER.
# Milestone 3 requirement: run the threshold sweep via
#   POST /api/experiments/threshold-sweep
# with your own validation frames and update this value with the evidence-
# selected result. The system will warn if this default is still in use.
RECOGNITION_THRESHOLD=0.40

# Quality gate parameters
MIN_FACE_SIZE=80           # Minimum face bounding box dimension in pixels
BLUR_THRESHOLD=80.0        # Laplacian variance — below this = too blurry
FACE_CONFIRMATION_FRAMES=5 # Frames a face must appear before being acted on

# ── Session timing defaults ───────────────────────────────────────────
# These are global defaults; per-classroom AttendanceConfiguration rows override them.
SESSION_START_OFFSET_MINUTES=0    # How many minutes before scheduled start the session opens
SESSION_LATE_START_MINUTES=5      # Arrivals after start + this offset are marked LATE
SESSION_LATE_END_MINUTES=15       # Arrivals after (end - this offset) are rejected
SESSION_DURATION_MINUTES=60       # Default session duration when not explicitly set

# ── WebSocket ─────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30          # Seconds between server-side pings

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/classroom.log       # Relative to backend/ directory

# ── LED / IoT ─────────────────────────────────────────────────────────
# Physical ESP32 + LED integration — FUTURE WORK (see §11 of project spec).
# When LED_ENABLED=false (default): LED events are software-simulated and
# broadcast via WebSocket only. The classroom display shows a simulated
# LED indicator. This is NOT physical hardware.
#
# To enable real MQTT publishing to an ESP32:
#   1. Set LED_ENABLED=true
#   2. Install paho-mqtt: pip install paho-mqtt
#   3. Configure broker below
#   4. Flash appropriate firmware to ESP32
LED_ENABLED=false
LED_MODE=mqtt                     # mqtt | http
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=classroom/led

# ── Rate limiting ─────────────────────────────────────────────────────
# These are compile-time constants in main.py, not env vars — listed here
# for documentation only:
#   RATE_LIMIT_WINDOW = 60 seconds
#   RATE_LIMIT_MAX_ATTEMPTS = 10 failed logins per IP per window
